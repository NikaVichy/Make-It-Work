    @page
@model MakeItWork.Pages.IndexModel
@{
}

@section styles{
    <link rel="stylesheet" href="~/Styles/Index.css">
}

@section scripts{
    <script src="~/Scripts/Index.js"></script>
}
<div class="container header-margin">
    <div class="task-container">
        @foreach(var task in Model.taskList){
            <div class="task">
                <a href="javascript:void(0)" class="task-name" data-id="@task.id">@task.taskName</a>
                <div class="project-tag-status">
                    <a href="/projects/@task.projectId" class="task-project">@task.projectName</a>
                    <div class="tag-container">
                        @* input tags *@
                        @* <div class="tag">
                            <img src="" alt="">
                        </div> *@
                    </div>
                </div>
                <p class="deadline">@task.dueTo?.ToString("s")</p>
            </div>
            <form method="post">
                <input type="hidden" value="@task.id" name="taskId">
                <input type="submit" asp-page-handler="Complete" value="Complete task">
                <input type="submit" asp-page-handler="Delete" value="Delete task">
            </form>
        }
    </div>
</div>