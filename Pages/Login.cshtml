@page
@model MakeItWork.Pages.LoginModel

@section Styles{
    <link href="@Url.Content("~/Styles/LoginRegister.css")" rel="stylesheet" type="text/css"/>
}

@section Scripts{
    <script src="~/Scripts/Login.js"></script>
}

<div class="container">
    <div class="main-element">
        <p class="logo-name centered-text">
            Make It Work
        </p>
        <p class="action-name centered-text">
            Log in
        </p>
        <form method="post" autocomplete="off">
            <input type="text" name="username" id="username" placeholder="Username" class="centered-text input-element user-input">
            <input type="password" name="password" id="password" placeholder="Password" class="centered-text input-element user-input">

            <button type="submit" id="submit-button" class="centered-text input-element submit-element">Planning never ends</button>
        </form>
    </div>
    <a href="/Register">
        <div id="sub-element">
            <p class="log-in-account">Don't have<br/>an account?</p>
        </div>
    </a>
</div>