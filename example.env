DATABASE_CONNECTION_STRING=Host=<host>;Port=<port>;Database=<database>;Username=<username>;Password=<password>;
# Example of string:
# DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=database;Username=nikavich;Password=nikavich;

TOTP_ENCRYPTION_MASTER=<32 byte key>
#Can be obtained via
# openssl rand -base64 32
